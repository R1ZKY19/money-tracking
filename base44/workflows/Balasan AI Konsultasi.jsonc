{
  "name": "Balasan AI Konsultasi",
  "description": "AI MONEY.T membalas otomatis pesan pengguna saat thread berada pada mode AI AUTO.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "balasan_ai_konsultasi",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "ai_reply": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "aiConsultationReply",
            "args": {
              "message_id": "${ .trigger.entity_id }",
              "trigger_key": "mt_int_7Qx4bV92LsPd31Ka8ZrW6Ynt"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Balasan AI MONEY.T",
            "description": "Hanya berjalan bila mode thread AI AUTO"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ConsultationMessage"
    }
  }
}
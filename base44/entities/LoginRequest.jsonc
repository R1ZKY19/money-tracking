{
  "name": "LoginRequest",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email yang mencoba login"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "attempted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu percobaan login terakhir"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "default": 1
    },
    "user_agent": {
      "type": "string",
      "maxLength": 300
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_by": {
      "type": "string"
    }
  },
  "required": [
    "email",
    "attempted_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    },
    "read": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    },
    "update": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    },
    "delete": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    }
  }
}
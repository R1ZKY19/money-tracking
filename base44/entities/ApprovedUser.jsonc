{
  "name": "ApprovedUser",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email yang disetujui untuk login"
    },
    "is_approved": {
      "type": "boolean",
      "default": true,
      "description": "Apakah email ini disetujui untuk login"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu persetujuan"
    },
    "role": {
      "type": "string",
      "enum": [
        "none",
        "super_master",
        "master_1",
        "master_2",
        "staf"
      ],
      "default": "none",
      "description": "Role akses pengguna. 'none' = member baru belum berpaket, hanya bisa akses Panduan Fitur."
    },
    "access_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Daftar modul yang bisa diakses (jika kosong = sesuai role default)"
    },
    "notes": {
      "type": "string",
      "description": "Catatan admin tentang user ini"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    },
    "read": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    },
    "update": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    },
    "delete": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    }
  }
}
{
  "name": "RolePermission",
  "type": "object",
  "properties": {
    "role_id": {
      "type": "string"
    },
    "role_name": {
      "type": "string"
    },
    "permission_id": {
      "type": "string"
    },
    "permission_slug": {
      "type": "string"
    }
  },
  "required": [
    "role_id",
    "permission_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
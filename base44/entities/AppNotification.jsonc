{
  "name": "AppNotification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "message": {
      "type": "string",
      "maxLength": 1000
    },
    "type": {
      "type": "string",
      "enum": [
        "system",
        "feature",
        "role",
        "login_request",
        "activity"
      ],
      "default": "system"
    },
    "target_email": {
      "type": "string",
      "description": "Kosong = untuk semua user"
    },
    "link": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.target_email": "{{user.email}}"
        },
        {
          "data.target_email": {
            "$exists": false
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ConsultationThread",
  "type": "object",
  "properties": {
    "thread_email": {
      "type": "string",
      "description": "Email pengguna pemilik percakapan"
    },
    "mode": {
      "type": "string",
      "enum": [
        "ai_auto",
        "manual"
      ],
      "default": "ai_auto",
      "description": "ai_auto = AI MONEY.T membalas otomatis, manual = hanya Admin"
    },
    "takeover_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu Admin mengambil alih percakapan"
    },
    "user_typing_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_typing_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_online_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_online_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "thread_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.thread_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "email": "rizkykucuk19@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.thread_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "email": "rizkykucuk19@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.thread_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "email": "rizkykucuk19@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    }
  }
}
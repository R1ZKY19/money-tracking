{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense",
        "saving",
        "debt",
        "receivable",
        "debt_payment",
        "receivable_receipt",
        "transfer",
        "investment"
      ]
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "reference": {
      "type": "string",
      "maxLength": 200
    },
    "is_import": {
      "type": "boolean",
      "default": false
    },
    "related_id": {
      "type": "string"
    },
    "related_type": {
      "type": "string"
    },
    "creditor_name": {
      "type": "string",
      "maxLength": 200
    },
    "debtor_name": {
      "type": "string",
      "maxLength": 200
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "interest_rate": {
      "type": "number",
      "minimum": 0
    },
    "destination_account_id": {
      "type": "string"
    },
    "destination_account_name": {
      "type": "string"
    },
    "operation_key": {
      "type": "string",
      "maxLength": 100
    },
    "transfer_pair_id": {
      "type": "string",
      "maxLength": 100
    }
  },
  "required": [
    "date",
    "type",
    "amount",
    "account_id",
    "currency"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
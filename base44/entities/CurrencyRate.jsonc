{
  "name": "CurrencyRate",
  "type": "object",
  "properties": {
    "base_currency": {
      "type": "string",
      "description": "Mata uang dasar, e.g. IDR"
    },
    "target_currency": {
      "type": "string",
      "description": "Mata uang tujuan, e.g. USD"
    },
    "rate": {
      "type": "number",
      "description": "Nilai tukar: 1 target_currency = rate base_currency"
    },
    "rate_inverse": {
      "type": "number",
      "description": "1 base_currency = rate_inverse target_currency"
    },
    "last_updated": {
      "type": "string",
      "description": "Waktu update terakhir ISO string"
    },
    "source": {
      "type": "string",
      "default": "auto",
      "description": "auto atau manual"
    }
  },
  "required": [
    "base_currency",
    "target_currency",
    "rate"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
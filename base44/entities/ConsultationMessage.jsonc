{
  "name": "ConsultationMessage",
  "type": "object",
  "properties": {
    "thread_email": {
      "type": "string",
      "description": "Email pengguna pemilik percakapan (identitas thread)"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string",
      "maxLength": 200
    },
    "is_ai": {
      "type": "boolean",
      "default": false,
      "description": "true jika balasan dibuat otomatis oleh AI MONEY.T, false jika Admin manusia"
    },
    "message": {
      "type": "string",
      "maxLength": 4000
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu pesan diterima perangkat penerima"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu pesan dibaca penerima"
    }
  },
  "required": [
    "thread_email",
    "sender_role",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.thread_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "email": "rizkykucuk19@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.thread_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "email": "rizkykucuk19@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.thread_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "email": "rizkykucuk19@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    }
  }
}
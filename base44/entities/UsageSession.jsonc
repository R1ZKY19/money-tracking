{
  "name": "UsageSession",
  "type": "object",
  "properties": {
    "session_key": {
      "type": "string",
      "maxLength": 100
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "ended_reason": {
      "type": "string",
      "maxLength": 100
    },
    "page_path": {
      "type": "string",
      "maxLength": 200
    },
    "user_agent": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "session_key",
    "user_id",
    "user_email",
    "started_at",
    "last_seen",
    "duration_seconds",
    "is_active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
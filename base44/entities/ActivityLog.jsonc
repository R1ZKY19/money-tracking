{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "Jenis aksi: login, logout, create, update, delete, view, payment, export"
    },
    "module": {
      "type": "string",
      "description": "Modul: auth, transaksi, hutang, piutang, tabungan, akun, pengaturan, budget"
    },
    "description": {
      "type": "string",
      "description": "Deskripsi lengkap aksi yang dilakukan"
    },
    "ip_address": {
      "type": "string",
      "description": "Alamat IP pengguna"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser/device info"
    },
    "entity_id": {
      "type": "string",
      "description": "ID entitas yang terdampak (jika ada)"
    },
    "entity_name": {
      "type": "string",
      "description": "Nama entitas yang terdampak"
    },
    "old_value": {
      "type": "string",
      "description": "Nilai sebelum perubahan (JSON string)"
    },
    "new_value": {
      "type": "string",
      "description": "Nilai setelah perubahan (JSON string)"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "warning"
      ],
      "default": "success"
    }
  },
  "required": [
    "action",
    "module",
    "description"
  ],
  "rls": {
    "create": {
      "created_by_id": {
        "$ne": null
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
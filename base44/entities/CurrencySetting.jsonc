{
  "name": "CurrencySetting",
  "type": "object",
  "properties": {
    "default_currency": {
      "type": "string",
      "default": "IDR",
      "description": "Mata uang utama sistem"
    },
    "auto_update": {
      "type": "boolean",
      "default": true
    },
    "last_sync": {
      "type": "string",
      "description": "Waktu sinkronisasi terakhir ISO string"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending"
      ],
      "default": "pending"
    },
    "active_currencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List kode mata uang aktif"
    }
  },
  "required": [
    "default_currency"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
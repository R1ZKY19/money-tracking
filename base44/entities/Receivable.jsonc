{
  "name": "Receivable",
  "type": "object",
  "properties": {
    "debtor_name": {
      "type": "string"
    },
    "total_amount": {
      "type": "number"
    },
    "remaining_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed"
      ],
      "default": "active"
    },
    "category_id": {
      "type": "string"
    },
    "interest_rate": {
      "type": "number",
      "default": 0,
      "description": "Bunga per bulan dalam persen (%)"
    },
    "interest_amount": {
      "type": "number",
      "default": 0,
      "description": "Total bunga yang telah terakumulasi"
    }
  },
  "required": [
    "debtor_name",
    "total_amount",
    "currency"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "SubscriptionPackage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "duration_days": {
      "type": "integer",
      "default": 30
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_system": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "slug",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "RecurringTransaction",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama transaksi rutin"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense",
        "saving"
      ],
      "description": "Jenis transaksi"
    },
    "category_id": {
      "type": "string",
      "description": "ID kategori"
    },
    "category_name": {
      "type": "string",
      "description": "Nama kategori"
    },
    "account_id": {
      "type": "string",
      "description": "ID akun"
    },
    "account_name": {
      "type": "string",
      "description": "Nama akun"
    },
    "amount": {
      "type": "number",
      "description": "Jumlah transaksi"
    },
    "currency": {
      "type": "string",
      "default": "IDR",
      "description": "Mata uang"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "biweekly",
        "monthly",
        "quarterly",
        "yearly"
      ],
      "description": "Frekuensi pengulangan"
    },
    "day_of_week": {
      "type": "integer",
      "description": "Hari dalam minggu (0-6) untuk weekly"
    },
    "day_of_month": {
      "type": "integer",
      "description": "Hari dalam bulan (1-31) untuk monthly"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal mulai"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal berakhir (opsional)"
    },
    "last_created_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal transaksi terakhir dibuat otomatis"
    },
    "description": {
      "type": "string",
      "description": "Keterangan"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Status aktif"
    }
  },
  "required": [
    "name",
    "type",
    "amount",
    "currency",
    "frequency",
    "start_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "FeatureTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "feature_id": {
      "type": "string"
    },
    "feature_slug": {
      "type": "string"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "purchase",
        "subscription",
        "refund"
      ]
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "stripe",
        "bank_transfer",
        "manual"
      ],
      "default": "stripe"
    },
    "stripe_payment_intent": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "expires_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "feature_id",
    "transaction_type",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
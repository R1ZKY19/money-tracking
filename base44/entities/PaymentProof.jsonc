{
  "name": "PaymentProof",
  "type": "object",
  "properties": {
    "buyer_email": {
      "type": "string",
      "description": "Email pembeli"
    },
    "buyer_name": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "STAF",
        "MASTER_2",
        "MASTER_1"
      ]
    },
    "tier_label": {
      "type": "string"
    },
    "expected_amount": {
      "type": "number",
      "minimum": 0
    },
    "detected_amount": {
      "type": "number",
      "minimum": 0
    },
    "detected_bank": {
      "type": "string"
    },
    "detected_account": {
      "type": "string"
    },
    "detected_date": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "proof_url": {
      "type": "string",
      "description": "URL bukti transfer"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "reason": {
      "type": "string",
      "description": "Alasan jika ditolak / catatan verifikasi"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "granted_role": {
      "type": "string"
    }
  },
  "required": [
    "buyer_email",
    "tier",
    "expected_amount",
    "proof_url"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "email": "rizkykucuk19@gmail.com"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    },
    "delete": {
      "user_condition": {
        "email": "rizkykucuk19@gmail.com"
      }
    }
  }
}
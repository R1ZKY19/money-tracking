{
  "name": "TransactionType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama tipe transaksi"
    },
    "code": {
      "type": "string",
      "description": "Kode unik, e.g. income, expense, saving"
    },
    "color": {
      "type": "string",
      "default": "#0D4F6D"
    },
    "icon": {
      "type": "string",
      "default": "Tag"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "Tipe bawaan sistem, tidak bisa dihapus"
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}",
          "data.is_system": false
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_system": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}",
          "data.is_system": false
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}",
          "data.is_system": false
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
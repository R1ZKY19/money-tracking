{
  "name": "Account",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Account name"
    },
    "currency": {
      "type": "string",
      "description": "Currency code: IDR, USD, SAR, JPY, EUR"
    },
    "initial_balance": {
      "type": "number",
      "description": "Initial balance",
      "default": 0
    },
    "current_balance": {
      "type": "number",
      "description": "Current balance",
      "default": 0
    },
    "icon": {
      "type": "string",
      "description": "Icon name",
      "default": "Wallet"
    },
    "color": {
      "type": "string",
      "description": "Color hex",
      "default": "#0D4F6D"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "account_number": {
      "type": "string",
      "description": "Nomor rekening bank"
    },
    "account_holder_name": {
      "type": "string",
      "description": "Nama pemilik rekening"
    }
  },
  "required": [
    "name",
    "currency"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
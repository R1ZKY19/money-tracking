{
  "name": "UserFeature",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "feature_id": {
      "type": "string"
    },
    "feature_slug": {
      "type": "string"
    },
    "is_purchased": {
      "type": "boolean",
      "default": false
    },
    "purchased_date": {
      "type": "string",
      "format": "date-time"
    },
    "expires_date": {
      "type": "string",
      "format": "date-time"
    },
    "transaction_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "feature_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
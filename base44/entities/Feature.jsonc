{
  "name": "Feature",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "parent_slug": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "monthly_cost": {
      "type": "number",
      "default": 0
    },
    "show_in_sidebar": {
      "type": "boolean",
      "default": true
    },
    "show_in_guide": {
      "type": "boolean",
      "default": true
    },
    "requires_permission": {
      "type": "string"
    },
    "is_system": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "slug",
    "category_id",
    "route"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
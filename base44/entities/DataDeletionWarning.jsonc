{
  "name": "DataDeletionWarning",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID user pemilik data"
    },
    "has_warning": {
      "type": "boolean",
      "default": false,
      "description": "Apakah user punya data yang akan segera dihapus"
    },
    "deletion_date": {
      "type": "string",
      "format": "date-time",
      "description": "Tanggal data tertua user akan dihapus"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Terakhir di-check oleh sistem"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
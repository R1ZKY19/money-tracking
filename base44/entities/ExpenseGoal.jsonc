{
  "name": "ExpenseGoal",
  "type": "object",
  "properties": {
    "category_id": {
      "type": "string",
      "description": "Kategori pengeluaran yang dipantau"
    },
    "category_name": {
      "type": "string"
    },
    "target_amount": {
      "type": "number",
      "description": "Target pengeluaran maksimal"
    },
    "period": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "yearly"
      ],
      "default": "monthly",
      "description": "Periode target"
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "alert_threshold": {
      "type": "number",
      "default": 80,
      "description": "Persentase (%) untuk trigger alert"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "category_id",
    "target_amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
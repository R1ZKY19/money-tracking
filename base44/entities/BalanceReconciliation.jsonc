{
  "name": "BalanceReconciliation",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "ID rekening bank"
    },
    "account_name": {
      "type": "string",
      "description": "Nama rekening bank"
    },
    "balance_before": {
      "type": "number",
      "description": "Saldo sistem sebelum cross check"
    },
    "balance_after": {
      "type": "number",
      "description": "Saldo aktual bank yang diinput"
    },
    "difference": {
      "type": "number",
      "description": "Selisih (saldo_aktual - saldo_sistem)"
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "status": {
      "type": "string",
      "enum": [
        "sesuai",
        "surplus",
        "minus"
      ],
      "default": "sesuai",
      "description": "Status hasil cross check"
    },
    "admin_name": {
      "type": "string",
      "description": "Nama staff yang melakukan cross check"
    },
    "reason": {
      "type": "string",
      "description": "Catatan / alasan (opsional)"
    },
    "ip_address": {
      "type": "string",
      "description": "Alamat IP staff (opsional)"
    },
    "device": {
      "type": "string",
      "description": "Info perangkat/browser staff (opsional)"
    }
  },
  "required": [
    "account_id",
    "account_name",
    "balance_before",
    "balance_after",
    "difference"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
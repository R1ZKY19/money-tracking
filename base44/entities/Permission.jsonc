{
  "name": "Permission",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "view",
        "create",
        "edit",
        "delete",
        "manage"
      ]
    },
    "description": {
      "type": "string"
    },
    "is_system": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "slug",
    "resource",
    "action"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}